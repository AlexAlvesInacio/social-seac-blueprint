# Somente chaves PÚBLICAS. O prefixo VITE_ faz o Vite embutir o valor no bundle
# que qualquer visitante baixa — quem protege os dados é a RLS do Supabase.
# service_role, sb_secret_… e senha do banco NUNCA entram aqui.
# Detalhes e como conferir: docs/12_RUNBOOK_OPERACAO.md

# https://<projeto>.supabase.co
VITE_SUPABASE_URL=

# Chave publishable do projeto (sb_publishable_…)
VITE_SUPABASE_ANON_KEY=
